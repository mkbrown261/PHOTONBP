# ============================================================
# UEOS Environment Configuration Template
# Copy to .env and fill in your values
# OR run: python setup/configure.py
# ============================================================

# Unreal Engine Remote Control
UE_REMOTE_CONTROL_HOST=127.0.0.1
UE_REMOTE_CONTROL_PORT=30010

# Tripo API — get your key at https://platform.tripo3d.ai
TRIPO_API_KEY=
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi

# Huanyuan3D API (optional)
HUANYUAN_API_KEY=
HUANYUAN_API_BASE=https://api.hunyuan.cloud.tencent.com/v1

# MetaTailor API (optional)
METATAILOR_API_KEY=
METATAILOR_API_BASE=https://api.metatailor.io/v1

# UEOS Settings
UEOS_ASSET_TEMP_DIR=C:/UEOS/temp
UEOS_LOG_LEVEL=INFO
