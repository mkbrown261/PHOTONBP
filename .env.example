# ============================================================
# UEOS Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git
# ============================================================

# Unreal Engine Remote Control
UE_REMOTE_CONTROL_HOST=127.0.0.1
UE_REMOTE_CONTROL_PORT=30010

# Tripo API
TRIPO_API_KEY=your_tripo_api_key_here
TRIPO_API_BASE=https://api.tripo3d.ai/v2/openapi

# Huanyuan3D API
HUANYUAN_API_KEY=your_huanyuan_api_key_here
HUANYUAN_API_BASE=https://api.hunyuan.cloud.tencent.com/v1

# MetaTailor API
METATAILOR_API_KEY=your_metatailor_api_key_here
METATAILOR_API_BASE=https://api.metatailor.io/v1

# UEOS Settings
UEOS_ASSET_TEMP_DIR=C:/UEOS/temp
UEOS_LOG_LEVEL=INFO
